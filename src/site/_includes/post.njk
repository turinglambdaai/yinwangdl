---
layout: base.njk
---
<article class="post">
  <a href="/" class="post-back">&larr; 返回列表</a>
  <header class="post-header">
    <h1>{{ title }}</h1>
    <div class="post-meta">
      <span>{{ author or "王垠" }}</span>
      {% if created %}
      <span class="sep">&middot;</span>
      <time>{{ created | isodate }}</time>
      {% endif %}
      {% if source %}
      <span class="sep">&middot;</span>
      <a href="{{ source }}" target="_blank" rel="noopener">原文</a>
      {% endif %}
    </div>
  </header>
  <div class="post-content">
    {{ content | safe }}
  </div>

  <aside class="wechat-cta">
    <div class="wechat-cta-body">
      <div class="wechat-cta-title">关注公众号，第一时间获取更新</div>
      <p class="wechat-cta-desc">本站文章更新会同步通知。公众号里还有站长原创的技术文章——编程语言、嵌入式、汽车电子。微信搜索 <strong>TuringLambdaAI</strong>，或扫右侧二维码关注。</p>
      <p class="wechat-cta-hint">长按识别二维码关注</p>
    </div>
    <img class="wechat-cta-qr" src="/wechat-qr.jpg" alt="公众号 TuringLambdaAI 二维码" width="112" height="112" loading="lazy">
  </aside>

  {% if olderPost or newerPost %}
  <nav class="post-nav" aria-label="文章导航">
    {% if olderPost %}
    <a class="post-nav-item post-nav-older" href="{{ olderPost.url }}">
      <span class="post-nav-label">&larr; 更早一篇</span>
      <span class="post-nav-title">{{ olderPost.data.title }}</span>
    </a>
    {% endif %}
    {% if newerPost %}
    <a class="post-nav-item post-nav-newer" href="{{ newerPost.url }}">
      <span class="post-nav-label">更新一篇 &rarr;</span>
      <span class="post-nav-title">{{ newerPost.data.title }}</span>
    </a>
    {% endif %}
  </nav>
  {% endif %}

  <div class="ad-mobile ad-mobile--inpost">
    <ins class="adsbygoogle"
      style="display:block"
      data-ad-client="ca-pub-3215512126020129"
      data-ad-slot="7014497615"
      data-ad-format="auto"
      data-full-width-responsive="true"></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
</article>
